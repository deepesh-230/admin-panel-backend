# Local Postgres
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/admin_panel"

# Neon — pooled host (-pooler) for the running app; direct host for prisma migrate/db push
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_DAYS=7
JWT_ACCESS_EXPIRES=15m

# Admin web origin used in password-reset emails
ADMIN_URL=http://localhost:5173
# Public API base used in local-disk uploaded file URLs (unused when Supabase Storage is set)
PUBLIC_API_URL=http://localhost:3000

# Supabase Storage — Project Settings → API
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=uploads

# SMTP (optional in local — if unset, reset links are logged to the console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Divyaang Disha <noreply@divyaangdisha.com>"

# Set true to return resetToken in API response (local only; never in production)
# AUTH_EXPOSE_RESET_TOKEN=true

# Local disk folder for uploads (default: ./uploads)
# UPLOAD_DIR=

# Mobile app contact screen (optional)
# CONTACT_ADDRESS=
# CONTACT_PHONE=
# CONTACT_EMAIL=
# CONTACT_LOGO_URL=
