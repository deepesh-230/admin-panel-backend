# Local Postgres
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/admin_panel"

# Neon — pooled host (-pooler) for the running app; direct host for prisma migrate/db push
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# Supabase Transaction pooler (port 6543) — preferred for Nest/Prisma
# Avoid Session pooler (:5432): it caps concurrent clients and causes intermittent 500/CORS errors
DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15&pool_timeout=20"

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_DAYS=7
JWT_ACCESS_EXPIRES=15m

# The app talks to Postgres via the node-postgres adapter; pgbouncer/connection_limit/pool_timeout
# in DATABASE_URL are only used by the Prisma CLI (db push / seed). App pool size:
# DB_POOL_MAX=5

# Bootstrap DDL + default seeding (system settings, payment plans, states, CMS pages) is opt-in.
# Run once with RUN_ENSURE_DDL=true on a fresh DB; leave unset/false otherwise — it adds
# hundreds of queries to every (cold) start.
# RUN_ENSURE_DDL=true

# DB_LOG_QUERIES=true logs every query; otherwise only queries >= DB_LOG_SLOW_MS (default 100)
# DB_LOG_QUERIES=false
# DB_LOG_SLOW_MS=100

# Admin web origin used in password-reset emails
ADMIN_URL=http://localhost:5173
# Public API base used in local-disk uploaded file URLs (unused when Supabase Storage is set)
PUBLIC_API_URL=http://localhost:3000

# Supabase Storage — Project Settings → API
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=uploads

# SMTP (optional in local — if unset, reset links are logged to the console)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Divyaang Disha <noreply@divyaangdisha.com>"

# Set true to return resetToken in API response (local only; never in production)
# AUTH_EXPOSE_RESET_TOKEN=true

# Local disk folder for uploads (default: ./uploads)
# UPLOAD_DIR=

# Mobile app contact screen (optional)
# CONTACT_ADDRESS=
# CONTACT_PHONE=
# CONTACT_EMAIL=
# CONTACT_LOGO_URL=

# Google Places (provider location autocomplete on admin web)
# GOOGLE_MAPS_API_KEY=

# Razorpay (sponsorship checkout — Dashboard → API Keys)
# Use test keys in development; live keys in production
# RAZORPAY_KEY_ID=rzp_test_xxxxx
# RAZORPAY_KEY_SECRET=your_key_secret

# Firebase Admin (mobile push)
# Prefer a file path (recommended). File should stay out of git.
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Or paste the full JSON as a single-line string:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
