{
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run vercel-build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{prisma/**,node_modules/.prisma/**,node_modules/@prisma/client/**}"
    }
  }
}
