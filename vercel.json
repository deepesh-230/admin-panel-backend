{
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run vercel-build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{api/nest/**,node_modules/.prisma/client/**,prisma/**}"
    }
  }
}
