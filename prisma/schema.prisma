generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String           @id @default(uuid())
  name        RoleName         @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model State {
  id               String               @id @default(uuid())
  name             String               @unique
  code             String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  isActive         Boolean              @default(true)
  serviceProviders ServiceProvider[]
  marketplaceProducts MarketplaceProduct[]
  users            User[]               @relation("UserPrimaryState")
  userStates       UserState[]
  enquiries        Enquiry[]
  homeBanners      HomeBanner[]
}

model User {
  id                       String                 @id @default(uuid())
  email                    String                 @unique
  passwordHash             String
  name                     String?
  phone                    String?
  location                 String?
  latitude                 Float?
  longitude                Float?
  digipin                  String?
  pincode                  String?
  km                       Int?                   @default(1)
  isActive                 Boolean                @default(true)
  /// Set when email/OTP verification succeeds
  emailVerifiedAt          DateTime?
  /// User opted in as volunteer during registration/profile
  wantsVolunteer           Boolean                @default(false)
  roleId                   String
  /// Primary/home state (especially for STATE_ADMIN)
  stateId                  String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  passwordResetTokens      PasswordResetToken[]
  refreshTokens            RefreshToken[]
  approvedServiceProviders ServiceProvider[]      @relation("ProviderApprovedBy")
  createdServiceProviders  ServiceProvider[]      @relation("ProviderCreatedBy")
  serviceProviderAdmins    ServiceProviderAdmin[]
  sessions                 Session[]
  marketplaceProducts      MarketplaceProduct[]
  payments                 Payment[]
  broadcasts               UserBroadcast[]
  becomeApplications       BecomeApplication[]
  role                     Role                   @relation(fields: [roleId], references: [id])
  state                    State?                 @relation("UserPrimaryState", fields: [stateId], references: [id])
  userStates               UserState[]
}

/// Many-to-many assignment of users to one or more states
model UserState {
  id        String   @id @default(uuid())
  userId    String
  stateId   String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stateId])
  @@index([stateId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session   Session?
}

/// Login session metadata (linked to a refresh token)
model Session {
  id             String       @id @default(uuid())
  userId         String
  refreshTokenId String       @unique
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  refreshToken   RefreshToken @relation(fields: [refreshTokenId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceProvider {
  id             String                 @id @default(uuid())
  name           String
  categoryId     String
  subcategoryId  String?
  description    String?
  phone          String?
  landline       String?
  email          String?
  website        String?
  address        String?
  city           String?
  stateId        String
  latitude       Float?
  longitude      Float?
  googlePlaceId  String?
  about          String?
  services       String?
  coverPhotoUrl  String?
  gallery        String[]               @default([])
  isActive       Boolean                @default(true)
  approvalStatus ProviderApprovalStatus @default(PENDING_APPROVAL)
  rejectedReason String?
  /// Manual business ID verification (GST/MCA etc.) — separate from listing approval until Approve.
  businessVerificationStatus BusinessVerificationStatus @default(NOT_INITIATED)
  mcaId          String?
  din            String?
  gstin          String?
  nmcId          String?
  panId          String?
  verificationSubmittedAt DateTime?
  verificationNote        String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  approvedBy     User?                  @relation("ProviderApprovedBy", fields: [approvedById], references: [id])
  category       Category               @relation(fields: [categoryId], references: [id])
  createdBy      User?                  @relation("ProviderCreatedBy", fields: [createdById], references: [id])
  state          State                  @relation(fields: [stateId], references: [id])
  subcategory    Subcategory?           @relation(fields: [subcategoryId], references: [id])
  admins         ServiceProviderAdmin[]
  enquiries      Enquiry[]

  @@index([stateId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([approvalStatus])
  @@index([businessVerificationStatus])
  @@index([isActive])
  @@index([name])
}

model ServiceProviderAdmin {
  id                String          @id @default(uuid())
  userId            String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  isPrimary         Boolean         @default(false)
  serviceProviderId String
  serviceProvider   ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceProviderId, userId])
  @@index([userId])
}

model Enquiry {
  id          String        @id @default(uuid())
  sNo         Int           @unique
  category    String
  subCategory String
  product     String
  name        String?
  email       String
  date        String
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  /// USER = app-user enquiry, PROVIDER = emergency / service-provider enquiry
  kind        String        @default("USER")
  status      EnquiryStatus @default(NEW)
  providerId  String?
  stateId     String?
  phone                  String?
  message                String?
  marketplaceProductId   String?
  adminFlag              AdminLifecycleFlag @default(ACTIVE)
  deletedAt              DateTime?
  marketplaceProduct     MarketplaceProduct? @relation(fields: [marketplaceProductId], references: [id], onDelete: SetNull)
  provider    ServiceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  state       State?           @relation(fields: [stateId], references: [id], onDelete: SetNull)

  @@index([kind])
  @@index([status])
  @@index([providerId])
  @@index([stateId])
  @@index([marketplaceProductId])
  @@index([adminFlag])
  @@index([deletedAt])
}

model Faq {
  id          String   @id @default(uuid())
  title       String
  slug        String?  @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UsefulLink {
  id          String          @id @default(uuid())
  title       String
  url         String
  isActive    Boolean         @default(true)
  broadcastAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  broadcasts  UserBroadcast[]
}

model SocialSetting {
  id        String   @id @default(uuid())
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([name])
}

model HelpTicket {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CmsPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id               String   @id @default(uuid())
  title            String
  shortDescription String?
  description      String?
  image            String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/** Home screen carousel banners (shown after Get Featured promo). */
model HomeBanner {
  id              String       @id @default(uuid())
  title           String?
  image           String
  url             String?
  sortOrder       Int          @default(0)
  isActive        Boolean      @default(true)
  /// Red = NATIONAL, Orange = STATE, Green = LOCAL
  coverageFlag    CoverageFlag @default(NATIONAL)
  coverageStateId String?
  coverageCity    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  coverageState   State?       @relation(fields: [coverageStateId], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([sortOrder])
  @@index([coverageFlag])
  @@index([coverageStateId])
}

model JobAlert {
  id          String              @id @default(uuid())
  title       String
  description String?
  postDate    String?
  lastDate    String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean             @default(true)
  adminFlag   AdminLifecycleFlag  @default(ACTIVE)
  deletedAt   DateTime?
  broadcastAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  broadcasts  UserBroadcast[]

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
  @@index([adminFlag])
  @@index([deletedAt])
}

/** Key/value central parameters editable from Central Admin Settings. */
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  label       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Suggestion {
  id           String             @id @default(uuid())
  title        String
  description  String?
  receivedFrom String?
  status       String             @default("OPEN")
  isActive     Boolean            @default(true)
  adminFlag    AdminLifecycleFlag @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([adminFlag])
  @@index([deletedAt])
}

model Event {
  id               String             @id @default(uuid())
  title            String
  description      String?
  location         String?
  startsAt         DateTime
  endsAt           DateTime?
  registrationLink String?
  contactInfo      String?
  isActive         Boolean            @default(true)
  adminFlag        AdminLifecycleFlag @default(ACTIVE)
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([location])
  @@index([startsAt])
  @@index([endsAt])
  @@index([isActive])
  @@index([adminFlag])
  @@index([deletedAt])
}

model Volunteer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MarketplaceProduct {
  id             String                     @id @default(uuid())
  name           String
  actualPrice    String?
  offerPrice     String?
  phone          String?
  listingIntent  String                     @default("sell")
  sellerName     String?
  description    String?
  address        String?
  color          String?
  brand          String?
  features       String?
  gallery        String[]                   @default([])
  location       String?
  stateId        String?
  createdById    String?
  isActive       Boolean                    @default(true)
  approvalStatus MarketplaceApprovalStatus  @default(PENDING)
  adminFlag      AdminLifecycleFlag         @default(ACTIVE)
  deletedAt      DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  createdBy      User?                      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  state          State?                     @relation(fields: [stateId], references: [id], onDelete: SetNull)
  enquiries      Enquiry[]

  @@index([createdById])
  @@index([isActive])
  @@index([stateId])
  @@index([approvalStatus])
  @@index([adminFlag])
  @@index([deletedAt])
  @@index([createdAt])
}

model MarketplaceParty {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  /// BUYER | SELLER
  kind      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model Listing {
  id          String   @id @default(uuid())
  sNo         Int      @unique
  category    String
  subCategory String
  product     String
  email       String
  image       String
  createdBy   String
  date        String
  status      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id               String            @id @default(uuid())
  name             String            @unique
  slug             String?           @unique
  description      String?
  /// CARE = Home tab, SERVICE = Providers tab
  type             CategoryType      @default(SERVICE)
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  serviceProviders ServiceProvider[]
  subcategories    Subcategory[]

  @@index([type])
}

model Subcategory {
  id               String            @id @default(uuid())
  categoryId       String
  name             String
  slug             String?
  description      String?
  isActive         Boolean           @default(true)
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  keywords         Keyword[]
  serviceProviders ServiceProvider[]
  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name])
  @@index([categoryId])
}

model Keyword {
  id            String      @id @default(uuid())
  term          String
  subcategoryId String
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([subcategoryId, term])
  @@index([term])
}

model Payment {
  id          String         @id @default(uuid())
  userId      String?
  payerName   String?
  payerEmail  String?
  payerPhone  String?
  amount      Decimal        @db.Decimal(12, 2)
  currency    String         @default("INR")
  status      PaymentStatus  @default(PENDING)
  purpose     PaymentPurpose @default(OTHER)
  planId      String?
  gateway     String?
  orderId     String?
  paymentId   String?        @unique
  referenceNo String?
  notes       String?
  paidAt      DateTime?
  /// Sponsorship / subscription validity end (set on successful payment)
  validUntil  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([purpose])
  @@index([paidAt])
  @@index([validUntil])
  @@index([userId])
  @@index([createdAt])
}

/** Configurable sponsorship / payment plans (Silver, Gold, Platinum). */
model PaymentPlan {
  id            String                   @id @default(uuid())
  code          String                   @unique
  name          String
  amount        Decimal                  @db.Decimal(12, 2)
  currency      String                   @default("INR")
  description   String?
  /// Length of plan validity (paired with durationUnit).
  durationValue Int                      @default(1)
  durationUnit  PaymentPlanDurationUnit  @default(YEAR)
  sortOrder     Int                      @default(0)
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

/** Admin-configured questions for "I want to become" applications. */
model BecomeQuestion {
  id        String             @id @default(uuid())
  target    BecomeTarget
  prompt    String
  type      BecomeQuestionType @default(TEXT)
  /// String[] of choice labels when type = SINGLE_CHOICE
  options   Json?
  sortOrder Int                @default(0)
  isRequired Boolean           @default(true)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  answers   BecomeAnswer[]

  @@index([target, isActive])
  @@index([sortOrder])
}

model BecomeApplication {
  id        String                   @id @default(uuid())
  userId    String?
  target    BecomeTarget
  status    BecomeApplicationStatus  @default(PENDING)
  name      String
  email     String
  phone     String?
  adminNote String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  user      User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers   BecomeAnswer[]

  @@index([target])
  @@index([status])
  @@index([email])
  @@index([userId])
  @@index([createdAt])
}

model BecomeAnswer {
  id             String              @id @default(uuid())
  applicationId  String
  questionId     String?
  questionPrompt String
  questionType   BecomeQuestionType
  answerText     String
  selectedOption String?
  createdAt      DateTime            @default(now())
  application    BecomeApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  question       BecomeQuestion?     @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([questionId])
}

model UserBroadcast {
  id           String               @id @default(uuid())
  userId       String
  contentType  BroadcastContentType
  jobAlertId   String?
  usefulLinkId String?
  title        String
  body         String?
  url          String?
  readAt       DateTime?
  createdAt    DateTime             @default(now())
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobAlert     JobAlert?            @relation(fields: [jobAlertId], references: [id], onDelete: Cascade)
  usefulLink   UsefulLink?          @relation(fields: [usefulLinkId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([jobAlertId])
  @@index([usefulLinkId])
}

enum RoleName {
  ADMIN
  STATE_ADMIN
  END_USER
  SERVICE_PROVIDER_ADMIN
  VOLUNTEER
}

enum ProviderApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PaymentPlanDurationUnit {
  MONTH
  YEAR
}

/// Red = NATIONAL, Orange = STATE, Green = LOCAL
enum CoverageFlag {
  NATIONAL
  STATE
  LOCAL
}

enum BusinessVerificationStatus {
  NOT_INITIATED
  IN_PROGRESS
  VERIFIED
  REJECTED
}

enum MarketplaceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdminLifecycleFlag {
  READ
  ACTIVE
  DELETE
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum CategoryType {
  CARE
  SERVICE
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentPurpose {
  SPONSORSHIP
  MARKETPLACE
  SUBSCRIPTION
  DONATION
  OTHER
}

enum BroadcastContentType {
  JOB_ALERT
  USEFUL_LINK
}

enum BecomeTarget {
  STATE_ADMIN
  VOLUNTEER
  PROVIDER_ADMIN
}

enum BecomeQuestionType {
  TEXT
  SINGLE_CHOICE
}

enum BecomeApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}
