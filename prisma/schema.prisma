// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  // from .env file
}

model Enquiry {
  id          String   @id @default(uuid())
  sNo         Int      @unique
  category    String
  subCategory String
  product     String
  name        String?
  email       String
  date        String
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Listing {
  id          String   @id @default(uuid())
  sNo         Int      @unique
  category    String
  subCategory String
  product     String
  email       String
  image       String
  createdBy   String
  date        String
  status      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
